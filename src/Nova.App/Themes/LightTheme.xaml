<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Light Theme Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E6F9FAFB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
</ResourceDictionary>
