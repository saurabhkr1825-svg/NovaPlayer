<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Dark Theme Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1117" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1D26" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#13161F" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#E613161F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3342" />
</ResourceDictionary>
