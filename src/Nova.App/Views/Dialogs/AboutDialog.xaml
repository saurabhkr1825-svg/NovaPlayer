<Window x:Class="Nova.App.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NovaPlayer"
        Width="580" Height="480"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/Resources/NovaPlayer.ico"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Resources/NovaPlayer.ico" Width="64" Height="64" Margin="0,0,18,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NovaPlayer" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 (x64)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Modern, high-performance Windows desktop media player" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="© 2026 NovaPlayer Open Source Contributors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- LICENSE & COMPLIANCE TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="About &amp; Architecture">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="8">
                        <TextBlock Text="Technology Stack" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="• C# 12 and .NET 8 LTS (WPF)&#x0a;• LibVLCSharp.WPF 3.9.2 with native LibVLC 3.0.21 runtime&#x0a;• SQLite with Microsoft.Data.Sqlite and WAL mode persistence&#x0a;• Serilog structured rolling file &amp; console diagnostics&#x0a;• CommunityToolkit MVVM and Microsoft Dependency Injection"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" Margin="0,0,0,14" />

                        <TextBlock Text="LibVLC Dynamic Linking &amp; LGPL-2.1 Notice" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="NovaPlayer dynamically links to the unmodified native LibVLC library via LibVLCSharp. LibVLC is licensed under the GNU Lesser General Public License version 2.1 (LGPL-2.1) or later. LibVLC is a registered trademark of VideoLAN.&#x0a;&#x0a;Users may freely inspect, modify, and replace the LibVLC shared libraries (libvlc.dll, libvlccore.dll, and plugins/) located in the application directory. The complete corresponding source code for the LibVLC components is available at:"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,4" />

                        <TextBlock Margin="0,0,0,10">
                            <Hyperlink NavigateUri="https://code.videolan.org/videolan/vlc" RequestNavigate="OnHyperlinkRequestNavigate">
                                https://code.videolan.org/videolan/vlc
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Third-Party Licenses">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="8">
                        <TextBlock Text="Summary of Third-Party Dependencies" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="LibVLC (VideoLAN)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: GNU Lesser General Public License v2.1 or later (LGPL-2.1)&#x0a;Copyright © VideoLAN and VLC authors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="LibVLCSharp &amp; LibVLCSharp.WPF" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: GNU Lesser General Public License v2.1 or later (LGPL-2.1)&#x0a;Copyright © 2018-2024 VideoLAN and LibVLCSharp authors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Microsoft.Data.Sqlite &amp; Extensions.DependencyInjection" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: MIT License&#x0a;Copyright © Microsoft Corporation. All rights reserved." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: MIT License&#x0a;Copyright © .NET Foundation and Contributors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Serilog &amp; Sinks" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: Apache License 2.0&#x0a;Copyright © Serilog Contributors" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="SQLite (Native Engine)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="License: Public Domain (Dedicated by D. Richard Hipp)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="View Full License Notice" Click="OnOpenLicensesFileClick" HorizontalAlignment="Left" Padding="12,6" FontSize="11" />
                <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnCloseClick" HorizontalAlignment="Right" Padding="20,6" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>
