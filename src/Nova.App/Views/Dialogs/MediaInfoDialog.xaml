<Window x:Class="Nova.App.Views.Dialogs.MediaInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Nova.Core.Models;assembly=Nova.Core"
        Title="Media Information — NovaPlayer"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="130" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Media Stream &amp; Container Specifications"
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,12" />

        <!-- Details ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- General Section -->
                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="File Name:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtFileName" Style="{StaticResource ValueStyle}" MaxWidth="480" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="File Path:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtFilePath" Style="{StaticResource ValueStyle}" MaxWidth="480" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Container Format:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtContainer" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Duration:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtDuration" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Video Stream Section -->
                <TextBlock Text="VIDEO STREAM" Style="{StaticResource SectionHeaderStyle}" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Codec:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtVideoCodec" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Resolution:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtResolution" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Frame Rate:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtFrameRate" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Bitrate:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtVideoBitrate" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Audio Stream Section -->
                <TextBlock Text="AUDIO STREAM" Style="{StaticResource SectionHeaderStyle}" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Codec:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtAudioCodec" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Channels:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtAudioChannels" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Sample Rate:" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="TxtAudioSampleRate" Style="{StaticResource ValueStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tracks Summary -->
                <TextBlock Text="TRACKS ENUMERATION" Style="{StaticResource SectionHeaderStyle}" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Audio Tracks" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ListBox x:Name="LstAudioTracks" Background="#12151D" BorderThickness="0" Height="90" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Subtitle Tracks" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ListBox x:Name="LstSubtitleTracks" Background="#12151D" BorderThickness="0" Height="90" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Width="100" Height="32" Click="OnCloseClick" />
    </Grid>
</Window>
