<Window x:Class="Nova.App.Views.Dialogs.EqualizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Nova.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:EqualizerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="10-Band Audio Equalizer — NovaPlayer"
        Height="420" Width="680"
        MinHeight="380" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Controls Bar: Enable, Presets, Reset -->
            <RowDefinition Height="Auto" />
            <!-- Preamp Gain -->
            <RowDefinition Height="Auto" />
            <!-- 10 Bands Sliders -->
            <RowDefinition Height="*" />
            <!-- Close Button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Controls: Enable, Preset, Reset -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsEnabled}"
                      Content="Enable Equalizer"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      FontWeight="SemiBold"
                      FontSize="13"
                      VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Preset:"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AvailablePresets}"
                          SelectedItem="{Binding SelectedPreset}"
                          Width="140" Height="28"
                          Background="{DynamicResource SurfaceAltBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          VerticalContentAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="↺ Reset (Flat)"
                    Command="{Binding ResetCommand}"
                    Padding="10,4"
                    FontSize="12"/>
        </Grid>

        <!-- Preamp Slider Row -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceAltBrush}"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Preamp"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Slider Grid.Column="1"
                        Minimum="-20" Maximum="20"
                        Value="{Binding PreampGainDb, Mode=TwoWay}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        Margin="12,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding PreampGainDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 10 Vertical Bands -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Bands}"
                      Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Gain text -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding GainDb, StringFormat='{}{0:+0;-0;0}'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <!-- Vertical Slider -->
                        <Slider Grid.Row="1"
                                Orientation="Vertical"
                                Minimum="-20" Maximum="20"
                                Value="{Binding GainDb, Mode=TwoWay}"
                                HorizontalAlignment="Center"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"/>

                        <!-- Frequency Label -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding FrequencyLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Close Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Click="OnCloseClick"
                    Padding="18,6"
                    Background="{DynamicResource AccentBrush}"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
