<Window x:Class="Nova.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:viewModels="clr-namespace:Nova.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:PlayerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700" Width="1120"
        MinHeight="450" MinWidth="700"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowKeyDown"
        MouseMove="OnWindowMouseMove">

    <Grid Background="#0A0B0E">
        <!-- Native Video Surface with Nested WPF Airspace Overlay -->
        <vlc:VideoView x:Name="VlcVideoView"
                       MediaPlayer="{Binding NativeMediaPlayer}">
            
            <!-- OVERLAY CONTAINER (Rendered above video surface by LibVLCSharp.WPF) -->
            <Grid x:Name="OverlayContainer"
                  Background="Transparent"
                  MouseLeftButtonDown="OnVideoSurfaceMouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Border Grid.Row="0"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        Padding="16,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Opacity="{Binding IsOverlayVisible, Converter={StaticResource BooleanToDoubleConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title and State -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NOVAPLAYER"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="14"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentMediaTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="500"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#F59E0B"
                                       FontSize="12"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Top Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="ℹ Media Info"
                                    Command="{Binding ShowMediaInfoCommand}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    ToolTip="View Media &amp; Codec Specifications (I)" />

                            <Button Content="📂 Open File"
                                    Command="{Binding OpenFileCommand}"
                                    Padding="14,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    ToolTip="Select Media File" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CENTER AREA (Buffering indicator or empty for video click) -->
                <Grid Grid.Row="1" Background="Transparent">
                    <!-- Buffering Indicator -->
                    <Border Background="#B3000000"
                            CornerRadius="8"
                            Padding="20,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBuffering, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ Buffering..."
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BOTTOM CONTROLS BAR -->
                <Border Grid.Row="2"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        Padding="16,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Opacity="{Binding IsOverlayVisible, Converter={StaticResource BooleanToDoubleConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Seek Bar Slider -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Slider x:Name="SeekSlider"
                                    Style="{StaticResource ModernSeekSlider}"
                                    Minimum="0"
                                    Maximum="{Binding TotalDurationMs}"
                                    Value="{Binding CurrentPositionMs, Mode=TwoWay}"
                                    PreviewMouseDown="OnSeekSliderMouseDown"
                                    PreviewMouseUp="OnSeekSliderMouseUp" />
                        </Grid>

                        <!-- Playback Controls Row -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Primary Controls: Play/Pause, Stop -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayPauseButton"
                                        Command="{Binding PlayPauseCommand}"
                                        Width="80" Height="34"
                                        Margin="0,0,8,0"
                                        FontWeight="Bold">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▶ Play" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="⏸ Pause" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <Button Content="⏹"
                                        Command="{Binding StopCommand}"
                                        Width="40" Height="34"
                                        Margin="0,0,16,0"
                                        ToolTip="Stop"/>
                            </StackPanel>

                            <!-- Time Elapsed / Total Duration -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTimeText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" / "
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalTimeText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Center: Track Selectors, Speed & Aspect Ratio -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Audio Track Selector -->
                                <Button Content="🎵 Audio"
                                        Click="OnAudioMenuButtonClick"
                                        Padding="10,4"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        ToolTip="Select Audio Track (A) / Audio Delay (G/H)" />

                                <!-- Subtitle Selector -->
                                <Button Content="💬 Subtitles"
                                        Click="OnSubtitleMenuButtonClick"
                                        Padding="10,4"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        ToolTip="Select Subtitles (S) / Subtitle Delay (J/K)" />

                                <!-- Speed Button (Click cycles, right-click menu) -->
                                <Button Content="{Binding PlaybackSpeedText}"
                                        Command="{Binding CyclePlaybackSpeedCommand}"
                                        Click="OnSpeedButtonClick"
                                        Padding="8,4"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        FontWeight="SemiBold"
                                        ToolTip="Playback Speed ([ / ] / Backspace)" />

                                <!-- Aspect Ratio Selector -->
                                <Button Content="{Binding SelectedAspectRatio}"
                                        Click="OnAspectRatioButtonClick"
                                        Padding="8,4"
                                        Height="30"
                                        ToolTip="Video Aspect Ratio" />
                            </StackPanel>

                            <!-- Right Controls: Volume & Fullscreen -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mute Button -->
                                <Button Command="{Binding ToggleMuteCommand}"
                                        Width="38" Height="34"
                                        Margin="0,0,8,0"
                                        ToolTip="Mute / Unmute (M)">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="🔊" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Text" Value="🔇" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- Volume Slider -->
                                <Slider Width="90"
                                        VerticalAlignment="Center"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        Margin="0,0,16,0"
                                        ToolTip="{Binding Volume, StringFormat='Volume: {0}%'}"/>

                                <!-- Fullscreen Button -->
                                <Button Content="⛶"
                                        Command="{Binding ToggleFullscreenCommand}"
                                        Width="38" Height="34"
                                        ToolTip="Toggle Fullscreen (F11 / F)"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
